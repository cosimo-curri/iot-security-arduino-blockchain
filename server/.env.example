# Copy to .env. NEVER commit .env or actual credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/iot_blockchain
HOST=127.0.0.1
PORT=3000
# COM6 on Windows, /dev/ttyACM0 on Linux, /dev/cu.usbmodem... on macOS.
# Leave empty to start the server without a connected Arduino.
ARDUINO_COM_PORT=
# Set true only for an unregistered classroom demonstration.
# Prefer npm run provision:device, then add its PUBLIC key below.
# A key stored in Arduino Uno flash can be physically extracted and its ECDSA
# nonce generation still depends on unverified embedded entropy.
ALLOW_UNREGISTERED_SIGNERS=false
AUTHORIZED_SIGNING_KEYS=
# Remote API and blockchain network are disabled for normal local demonstrations.
ALLOW_REMOTE_API=false
PEER_URLS=
PEER_SHARED_TOKEN=

# Optional real-MongoDB test setting. The test runner reads MONGO_TEST_URI
# from the shell environment, NOT from this .env file. Export it explicitly
# before `npm test`; use only a disposable test database.
MONGO_TEST_URI=
